+"""
+B-spline temporal projection for ScoreHMR pred_noise smoothing.
+Builds the design matrix B (N x M) and provides least-squares projection X_smooth = B @ pinv(B) @ X
+so that the result is C^{order-2} continuous along the first (time) dimension.
+"""
+from __future__ import annotations
+
+import numpy as np
+from pathlib import Path
+from typing import Any, Dict, Optional, Tuple, Union
+
+import torch
+import yaml
+
+
+def _cox_de_boor_basis(t: float, knot_idx: int, order: int, knots: np.ndarray) -> float:
+    """Single B-spline basis N_{knot_idx, order}(t) via Cox-de Boor recursion."""
+    k = order
+    u = knots
+
+    def N(i: int, p: int) -> float:
+        if p == 0:
+            if i >= len(u) - 1:
+                return 0.0
+            # Include right endpoint for last knot span so the final frame is in the support
+            if i == len(u) - 2:
+                return 1.0 if (u[i] <= t <= u[i + 1]) else 0.0
+            return 1.0 if (u[i] <= t < u[i + 1]) else 0.0
+        a1 = (t - u[i]) * N(i, p - 1) / (u[i + p] - u[i]) if (u[i + p] - u[i]) > 1e-12 else 0.0
+        a2 = (u[i + p + 1] - t) * N(i + 1, p - 1) / (u[i + p + 1] - u[i + 1]) if (u[i + p + 1] - u[i + 1]) > 1e-12 else 0.0
+        return a1 + a2
+
+    return N(knot_idx, k - 1)
+
+
+def build_bspline_basis_matrix(
+    num_frames: int,
+    num_control_points: int,
+    order: int = 4,
+    t_min: float = 0.0,
+    t_max: Optional[float] = None,
+) -> np.ndarray:
+    """
+    Build B-spline basis matrix B of shape (num_frames, num_control_points).
+    Frame indices are mapped to parameter t in [t_min, t_max]. Default [0, 1] so the last frame is included.
+    Uses clamped uniform knot vector so the curve interpolates at boundaries.
+    """
+    if t_max is None:
+        t_max = 1.0
+    k = order
+    M = num_control_points
+    if M < k:
+        M = k
+    interior_count = M - k
+    if interior_count > 0:
+        interior = np.linspace(t_min, t_max, interior_count + 2)[1:-1]
+        knots = np.concatenate([[t_min] * k, interior, [t_max] * k])
+    else:
+        knots = np.array([t_min] * k + [t_max] * k)
+
+    t_vals = np.linspace(t_min, t_max, num_frames, dtype=np.float64)
+    B = np.zeros((num_frames, M), dtype=np.float64)
+    for i in range(num_frames):
+        for j in range(M):
+            B[i, j] = _cox_de_boor_basis(float(t_vals[i]), j, k, knots)
+    return B
+
+
+def project_onto_bspline_temporal(
+    X: torch.Tensor,
+    B: torch.Tensor,
+) -> torch.Tensor:
+    """
+    Project X onto the B-spline temporal subspace: X_smooth = B @ (B^T B)^{-1} B^T @ X.
+    X: (N, D), B: (N, M). Returns (N, D) on same device/dtype as X.
+    """
+    # C = (B^T B)^{-1} B^T X  ->  solve B^T B C = B^T X  ->  C (M, D)
+    BtB = B.T @ B
+    BtX = B.T @ X
+    # C = torch.linalg.solve(BtB, BtX)  # (M, D)
+    C = torch.linalg.solve(BtB, BtX)  # (M, D)
+    X_smooth = B @ C
+    return X_smooth
+
+
+def resolve_m_per_t(
+    m_per_t_cfg: Union[int, str],
+    num_frames: int,
+    fps: Optional[float] = None,
+) -> int:
+    """
+    Resolve m_per_t config to integer number of control points M (total over the whole sequence).
+
+    Semantics:
+    - int: M = that number (clamped to [order, num_frames]).
+    - "fps": one control point per frame (M = num_frames) or per second if you prefer; we use M = ceil(num_frames) bounded.
+    - "fps_div_2", "fps_div_3", ...: **one control point every (fps/div) frames** -> spacing = fps/div, M = ceil(num_frames / spacing) = ceil(num_frames * div / fps).
+      E.g. fps_div_3 with fps=30 -> spacing=10 frames -> M = ceil(num_frames/10).
+    - "every_<K>": one control point every K frames -> M = ceil(num_frames / K).
+    """
+    order = 4  # cubic
+    if isinstance(m_per_t_cfg, int):
+        M = max(order, min(m_per_t_cfg, num_frames))
+        return M
+    s = str(m_per_t_cfg).strip().lower()
+    if s.startswith("every_"):
+        try:
+            k = int(s.split("_")[-1])
+            if k < 1:
+                k = 1
+            return max(order, min(int(np.ceil(num_frames / k)), num_frames))
+        except (ValueError, IndexError):
+            pass
+    if s.startswith("frames_per_ctrl_"):
+        try:
+            k = int(s.split("_")[-1])
+            if k < 1:
+                k = 1
+            return max(order, min(int(np.ceil(num_frames / k)), num_frames))
+        except (ValueError, IndexError):
+            pass
+    if s == "fps":
+        if fps is not None and fps > 0:
+            # one control point per second: spacing = fps frames -> M = ceil(num_frames / fps)
+            return max(order, min(int(np.ceil(num_frames / fps)), num_frames))
+        return max(order, min(num_frames, 30))
+    # fps_div_K: one control point every (fps/K) frames -> M = ceil(num_frames / (fps/K)) = ceil(num_frames * K / fps)
+    if s.startswith("fps_div_"):
+        try:
+            div = int(s.split("_")[-1])
+        except (ValueError, IndexError):
+            div = 2
+        if fps is not None and fps > 0:
+            spacing = fps / div  # frames between control points
+            M = int(np.ceil(num_frames / spacing))
+        else:
+            M = max(1, num_frames // div)
+        return max(order, min(M, num_frames))
+    try:
+        return max(order, min(int(m_per_t_cfg), num_frames))
+    except (ValueError, TypeError):
+        return max(1, num_frames // 4)
+
+
+def load_bspline_config(config_path: Optional[Path] = None) -> Dict[str, Any]:
+    """Load B-spline config from custom/configs/bspline.yaml. Returns dict with order, m_per_t."""
+    if config_path is None:
+        # ScoreHMR/custom/configs/bspline.yaml relative to this file: custom/utils/bspline.py -> custom/configs/
+        base = Path(__file__).resolve().parent.parent
+        config_path = base / "configs" / "bspline.yaml"
+    if not config_path.exists():
+        return {"order": 4, "m_per_t": "fps_div_2"}
+    with open(config_path, "r") as f:
+        data = yaml.safe_load(f)
+    return data if isinstance(data, dict) else {"order": 4, "m_per_t": "fps_div_2"}
+
+
+class BsplineTemporalProjector:
+    """
+    Caches the projection matrix for a fixed (N, M, order) so that repeated
+    project_temporal() calls only do the matmul, not the basis build/solve.
+    """
+
+    def __init__(
+        self,
+        num_frames: int,
+        num_control_points: int,
+        order: int = 4,
+        use_tanh: bool = False,
+        tanh_amp: float = 1.0,
+        device: Optional[torch.device] = None,
+        dtype: Optional[torch.dtype] = None,
+    ):
+        self.N = num_frames
+        self.M = num_control_points
+        self.order = order
+        self.use_tanh = bool(use_tanh)
+        self.tanh_amp = float(tanh_amp)
+        B_np = build_bspline_basis_matrix(num_frames, num_control_points, order=order)
+        self.B = torch.from_numpy(B_np).float()
+        if device is not None:
+            self.B = self.B.to(device)
+        if dtype is not None:
+            self.B = self.B.to(dtype)
+        BtB = self.B.T @ self.B
+        self._BtB_inv = torch.linalg.inv(BtB)
+
+    def project(self, X: torch.Tensor) -> torch.Tensor:
+        """X: (N, D) -> (N, D) on same device/dtype as X. Moves B/BtB_inv to X's device/dtype if needed."""
+        dev, d = X.device, X.dtype
+        B = self.B.to(device=dev, dtype=d)
+        BtB_inv = self._BtB_inv.to(device=dev, dtype=d)
+        C = BtB_inv @ (B.T @ X)
+        if bool(self.use_tanh):
+            a = float(self.tanh_amp)
+            if a > 0:
+                C = a * torch.tanh(C / a)
+            else:
+                C = torch.tanh(C)
+        return B @ C
