+"""
+Keep package imports lightweight.
+
+The demo utilities import submodules like `score_hmr.utils`, which implicitly import
+the package. Avoid importing training-time dependencies at import time.
+"""
+
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from .trainer import Trainer as Trainer
+    from .diffusion import GaussianDiffusion as GaussianDiffusion
+
+__all__ = ["Trainer", "GaussianDiffusion"]
+
+
+def __getattr__(name: str):
+    if name == "Trainer":
+        from .trainer import Trainer
+        return Trainer
+    if name == "GaussianDiffusion":
+        from .diffusion import GaussianDiffusion
+        return GaussianDiffusion
+    raise AttributeError(name)
