+# B-spline temporal smoothing for pred_noise (optional, default off in diffusion).
+# When enabled, at each DDIM step the noise is projected onto a C^2 B-spline curve
+# along the frame dimension before updating x_t.
+# Used only when use_bspline_smooth_noise is True (e.g. from wrapper kwargs).
+
+# B-spline order (degree + 1). 4 = cubic, C^2 continuous.
+order: 4
+
+# m_per_t = "每多少帧放一个控制点" 的等价配置：
+#   "fps_div_3"   -> 每 (fps/3) 帧一个控制点，如 fps=30 则每 10 帧一个 -> M = ceil(num_frames/10)
+#   "fps_div_2"   -> 每 (fps/2) 帧一个；"fps_div_4" -> 每 (fps/4) 帧一个
+#   "fps"         -> 每 fps 帧一个（约每秒一个）
+#   integer       -> M = 该数（总控制点数）
+#   "every_30"    -> 每 30 帧一个 -> M = ceil(num_frames/30)
+# FPS 来自 batch["fps"] 或 wrapper。
+m_per_t: "fps_div_3"
+
+# Elastic soft blend: x_start_smooth = (1 - blend_weight) * x_start_raw + blend_weight * x_start_proj.
+# Avoids gradient erasure and 6D collapse: w=0.4 keeps 2D alignment while pulling toward smooth manifold.
+# Lower (0.2-0.3) = more 2D accuracy, less smooth; higher (0.5-0.6) = smoother, risk of floating.
+blend_weight: 0.6
+
+use_tanh: true
+tanh_amp: 10.0
